DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Segredo de assinatura do JWT (HS256). Minimo 32 bytes.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Conta inicial de acesso a API. A senha e recebida em texto claro e apenas o
# hash BCrypt e persistido. Trocar o valor e reiniciar rotaciona a credencial.
# Esta e a unica credencial do sistema: use uma passphrase longa.
AUTH_BOOTSTRAP_USUARIO=
AUTH_BOOTSTRAP_SENHA=

# Origens liberadas no CORS, separadas por virgula, SEM barra final.
# Ex.: https://regula-ai-front.vercel.app,https://regula-ai-front-*.vercel.app
APP_CORS_ORIGENS_PERMITIDAS=
